<Window x:Class="CncRemasterWorkshopFixer.RemoveConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Remove from Game" Width="680" Height="520" MinWidth="540" MinHeight="400"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip" ShowInTaskbar="False"
        Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI" Closing="Window_Closing">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,14">
            <TextBlock Text="Remove selected maps from C&amp;C?" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Margin="0,7,0,0" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"
                       Text="{Binding Message}" />
        </StackPanel>

        <!-- The complete filename list is the safety confirmation, so keep it scrollable
             rather than truncating large selections or summarizing their targets. -->
        <ListBox Grid.Row="1" ItemsSource="{Binding Items}" Background="{DynamicResource PanelBrush}"
                 Foreground="{DynamicResource TextBrush}"
                 BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                 ScrollViewer.VerticalScrollBarVisibility="Auto" Padding="8">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="4,5,4,9">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Details}" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,4" />
                        <ItemsControl ItemsSource="{Binding FileNames}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="12"
                                               Foreground="{DynamicResource MutedBrush}" Margin="12,1,0,0" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2" Margin="0,14,0,0">
            <CheckBox x:Name="UnsubscribeOption" Content="{Binding UnsubscribeLabel}"
                      Visibility="{Binding UnsubscribeVisibility}" IsChecked="False" Margin="0,0,0,8" />
            <TextBlock x:Name="OperationStatus" Text="Subscriptions stay unchanged unless you select Also unsubscribe."
                       TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,8" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" Content="Cancel" Click="Cancel_Click" IsCancel="True" Margin="0,0,8,0" />
                <Button x:Name="RemoveButton" Content="Remove from Game" Click="Remove_Click" IsDefault="True"
                        Style="{StaticResource PrimaryButton}" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
