<Window x:Class="CncRemasterWorkshopFixer.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CncRemasterWorkshopFixer"
        Title="About C&amp;C Remastered Steam Workshop Map Fixer"
        Icon="Assets/Icons/TiberiumCore.ico"
        Width="520" Height="370" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI" UseLayoutRounding="True" SnapsToDevicePixels="True"
        KeyboardNavigation.TabNavigation="Cycle">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image Source="Assets/Icons/TiberiumCore_1024.png" Width="56" Height="56"
                   Margin="0,0,16,0" VerticalAlignment="Top"
                   RenderOptions.BitmapScalingMode="HighQuality" />
            <StackPanel Grid.Column="1">
                <TextBlock Text="C&amp;C Remastered Steam Workshop Map Fixer"
                           FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock x:Name="VersionText" Margin="0,8,0,0"
                           Foreground="{DynamicResource MutedBrush}" />
                <TextBlock Text="Created by Terra_Ex" Margin="0,4,0,0" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="5" Padding="16" Margin="0,20,0,0">
            <TextBlock Text="Safely enables downloaded Steam Workshop maps for Command &amp; Conquer Remastered Collection."
                       TextWrapping="Wrap" />
        </Border>

        <TextBlock Grid.Row="2" Text="{x:Static local:AboutWindow.CopyrightNotice}" Margin="0,16,0,0"
                   Foreground="{DynamicResource MutedBrush}" />

        <TextBlock Grid.Row="3" Margin="0,12,0,0" TextWrapping="Wrap"
                   Foreground="{DynamicResource MutedBrush}"
                   Text="Unofficial community utility. Not affiliated with or endorsed by Electronic Arts, Petroglyph, or Valve." />

        <Grid Grid.Row="4">
            <Button Content="{x:Static local:AboutWindow.ReleasesButtonText}" Click="GitHubReleases_Click"
                    MinWidth="132" HorizontalAlignment="Left" />
            <Button Content="Close" IsDefault="True" IsCancel="True"
                    Click="Close_Click" MinWidth="84" HorizontalAlignment="Right" />
        </Grid>
    </Grid>
</Window>
