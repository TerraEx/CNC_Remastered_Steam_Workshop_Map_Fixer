<Window x:Class="CncRemasterWorkshopFixer.ModifiedLocalConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Repair Modified Local Files" Width="560" Height="430" MinWidth="460" MinHeight="340"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI" UseLayoutRounding="True">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Repair modified Direct Local files?" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Margin="0,12,0,14" TextWrapping="Wrap"
                       Text="These Direct Local map files differ from the version previously installed by the fixer. Repairing them will replace the modified local files with the current Steam Workshop package." />
        </StackPanel>
        <ListBox Grid.Row="1" ItemsSource="{Binding}" Background="{DynamicResource PanelBrush}"
                 BorderBrush="{DynamicResource BorderBrush}" Foreground="{DynamicResource TextBrush}" />
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" IsCancel="True" Click="Cancel_Click" MinWidth="90" Margin="0,0,8,0" />
            <Button Content="Repair Files" IsDefault="True" Click="Repair_Click" MinWidth="110" />
        </StackPanel>
    </Grid>
</Window>
